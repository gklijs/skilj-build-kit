# ---> Rust
# Generated by Cargo — will have compiled files and executables
debug
target

# This is an application (has a [[bin]] target), not a library — Cargo.lock
# IS committed on purpose so every deploy and every CI run builds the exact
# same dependency graph. Don't add a blanket "Cargo.lock" ignore here the way
# a library crate would.

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# Generated by cargo mutants
**/mutants.out*/

.idea/
.claude/settings.local.json
.mcp.json
